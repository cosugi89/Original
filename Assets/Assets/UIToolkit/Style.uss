#root {
    position: relative;
    width: 100%;
    height: 100%;
}

#mainUI {
    width: 100%;
    height: 100%;
}

.background {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Assets/Picture/Title.png?fileID=-25533031545326202&guid=ba777c12343e99848b9960fafe7a9689&type=3#Title 1_0");
}

.top-area {
    flex-grow: 1;
    align-items: flex-end;
    margin-top: 100px;
    margin-right: 100px;
}

.middle-area {
    flex-grow: 1;
    justify-content: center;
}

.bottom-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.common-text {
    color: white;
    text-align: center;
    font-size: 56px;
}

.common-button {
    background-color: rgba(0, 0, 0, 0);
    color: white;
    border-width: 3px;
    border-color: white;
    border-radius: 15px;
}

.small-button {
    width: 250px;
    height: 100px;
    font-size: 36px;
}

.start-button {
    width: 469px;
    height: 149px;
    font-size: 55px;
}

.modalLayer {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    display: none;

    justify-content: center;
    align-items: center;

    background-color: rgba(0, 0, 0, 0.7);
}

.dialog {

    display: flex;
    width: 800px;
    max-width: 80%;
    height: 400px;

    border-width: 3px;
    border-color: white;
    border-radius: 30px;

    flex-direction: column;
    align-items: center;
    justify-content: space-around;

    transition-property: scale, opacity;
    transition-duration: 0.2s;
}

.dialog.show {
    scale: 1;
    opacity: 1;
}
