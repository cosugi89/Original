        height: 6
        startX: 2
        startY: 5
      enemy:
        enemyName: June
        maxHp: 100
      turnDefinitions:
      - label: Opening Attack
        enemyAction: 0
        boardSummary: 通常危険が1グループだけ見えている基本盤面。
        confirmText: いける
        notes: 最小構成のターン。Attack から Goal までの基本解決を確認する。
        enemyActionDamage: 80
        hazardGroups: []
        cellPlacements:
        - x: 2
          y: 5
          nodeType: 0
          hazardGroupId: -1
        - x: 2
          y: 4
          nodeType: 5
          hazardGroupId: -1
        - x: 2
          y: 3
          nodeType: 8
          hazardGroupId: -1
      - label: Jump Evade
        enemyAction: 0
        boardSummary: 通常危険の先に Goal が置かれた盤面。
        confirmText: 跳ぶ！
        notes: Jump で通常危険を回避し、そのまま Jump Attack まで繋ぐ。
        enemyActionDamage: 0
